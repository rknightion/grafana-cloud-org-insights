#!/usr/bin/env bash
# Execute a generic tool under one validated non-secret consumer projection.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MANIFEST=""
DEPLOYMENT_ROOT=""
TERRAFORM=""
KIND=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --manifest) MANIFEST="$2"; shift 2 ;;
    --deployment-root) DEPLOYMENT_ROOT="$2"; shift 2 ;;
    --terraform) TERRAFORM="$2"; shift 2 ;;
    --kind) KIND="$2"; shift 2 ;;
    --) shift; break ;;
    -h|--help)
      echo "usage: $0 --manifest PATH --deployment-root PATH --terraform PATH --kind KIND -- COMMAND [ARGS...]"
      exit 0 ;;
    *) echo "error: unknown argument $1" >&2; exit 2 ;;
  esac
done
test -n "$MANIFEST" && test -n "$DEPLOYMENT_ROOT" && test -n "$TERRAFORM" && test -n "$KIND" && test "$#" -gt 0 || {
  echo "error: manifest, deployment root, Terraform file, kind, and command are required" >&2
  exit 2
}

python3 "$ROOT/bin/consumer_manifest.py" check \
  --manifest "$MANIFEST" --generic-source "$ROOT" \
  --deployment-root "$DEPLOYMENT_ROOT" --terraform "$TERRAFORM" >/dev/null
runtime_env=()
while IFS= read -r pair; do
  runtime_env+=("$pair")
done < <(python3 "$ROOT/bin/consumer_manifest.py" env --manifest "$MANIFEST" "$KIND")

cd "$ROOT"
exec env "${runtime_env[@]}" "$@"
